# Copy to backend/.env (gitignored) and fill in.
ANTHROPIC_API_KEY=
# Any random string of 32+ characters, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Optional; defaults to the docker compose database on port 5433.
# DATABASE_URL=postgresql://patternly:patternly@localhost:5433/patternly
# Optional: grade by word matching instead of the tutor (no API calls).
# API_FLAGS=--offline
